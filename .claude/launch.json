{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "community",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--"
      ],
      "port": 5179,
      "autoPort": true
    },
    {
      "name": "mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "dev",
        "--mode",
        "mock"
      ],
      "port": 5186,
      "autoPort": true
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "--directory",
        "mockups"
      ],
      "port": 5180,
      "autoPort": true
    }
  ]
}